# Environment variables for Electricity Fee Management System.
# Copy this file to .env and fill in real values. .env is git-ignored.

# Core
SECRET_KEY=elec-fee-dev-secret-change-me
HOST=0.0.0.0
PORT=8173
DEBUG=false

# Sync source: excel | mysql
SYNC_SOURCE=excel
EXCEL_A_PATH=C:\Users\Karry\Desktop\电费\电费结算登记表.xlsx
EXCEL_B_PATH=C:\Users\Karry\Desktop\电费\电费情况20260907.xlsx

# MySQL (only if SYNC_SOURCE=mysql). Keep password out of repo.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=***
MYSQL_TABLE=site_info_pro

# Auth
ADMIN_TOKEN=***
SCAN_SECRET=***
